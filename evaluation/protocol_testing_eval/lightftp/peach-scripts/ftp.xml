		<String name="crlf" value="&#13;&#10;"/>
	</DataModel>

	<!-- <SIZE> ::= "SIZE" <space> <dir_file> <crlf>;  <dir_file> ::= (<directory> '/')? <file> -->
	<DataModel name="SIZE">
		<String name="verb" value="SIZE"/>
		<String name="space" value=" "/>
		<Block name="dir_file">
			<Block name="dir" minOccurs="0" maxOccurs="1">
				<String name="directory" value="dir_1/dir_2"/>
				<String name="slash" value="/"/>
			</Block>
			<Block name="file">
				<String name="filesystem_name" value="rn_1"/>
				<Block name="extension" minOccurs="0" maxOccurs="1">
					<String name="dot" value="."/>
					<String name="filesystem_name" value="txt"/>
				</Block>
			</Block>
		</Block>
		<String name="crlf" value="&#13;&#10;"/>
