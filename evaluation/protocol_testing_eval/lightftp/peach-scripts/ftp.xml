	<!-- <LIST> ::= "LIST" (<space> <directory>)? <crlf>
	     where str(<LIST>.<directory>) == "dir_1" or str(<LIST>.<directory>) == "dir_1/dir_2" -->
	<DataModel name="LIST">
		<String name="verb" value="LIST"/>
		<Block name="argument" minOccurs="0" maxOccurs="1">
			<String name="space" value=" "/>
			<Choice name="directory">
				<String name="dir_1" value="dir_1"/>
				<String name="dir_1_dir_2" value="dir_1/dir_2"/>
			</Choice>
		</Block>
		<String name="crlf" value="&#13;&#10;"/>
	</DataModel>

	<!-- <REST> ::= "REST" <space> <marker> <crlf>;  <marker> ::= r"[a-zA-Z0-9\-\.]+" -->
	<DataModel name="REST">
		<String name="verb" value="REST"/>
		<String name="space" value=" "/>
		<String name="marker" value="0"/>
		<String name="crlf" value="&#13;&#10;"/>
