<?xml version="1.0" encoding="utf-8"?>
<!--Peach translation of fandango-scripts/ftp.fan (+ ftp_client.fan).-->
<Peach xmlns="http://peachfuzzer.com/2012/Peach"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://peachfuzzer.com/2012/Peach peach.xsd">

	<Import import="random"/>


	<!-- <response_tail> ::= <space> <text> <crlf> -->
	<DataModel name="response_tail">
		<String name="space" value=" " token="true"/>
		<String name="text"/>
		<String name="crlf" value="&#13;&#10;" token="true"/>
	</DataModel>

	<!-- <file> ::= <filesystem_name> ('.' <filesystem_name>)?
	     for APPE/RETR, where str(<file>) == "exist_append.txt" makes the extension mandatory.
	     (Peach emits an element with minOccurs="0" zero times unless mutated.) -->
	<DataModel name="file_exist_append">
		<String name="filesystem_name" value="exist_append"/>
		<Block name="extension">
			<String name="dot" value="."/>
			<String name="filesystem_name" value="txt"/>
		</Block>
	</DataModel>


	<!-- <QUIT> ::= "QUIT" <crlf> -->
	<DataModel name="QUIT">
		<String name="verb" value="QUIT"/>
		<String name="crlf" value="&#13;&#10;"/>
	</DataModel>

	<!-- <USER> ::= "USER" <space> <word> <crlf>;  where str(<USER>.<word>) == "webadmin" -->
	<DataModel name="USER">
		<String name="verb" value="USER"/>
		<String name="space" value=" "/>
		<String name="word" value="webadmin"/>
		<String name="crlf" value="&#13;&#10;"/>
	</DataModel>

	<!-- <PASS> ::= "PASS" <space> <text> <crlf>;  where str(<PASS>.<text>) == "ubuntu" -->
	<DataModel name="PASS">
		<String name="verb" value="PASS"/>
		<String name="space" value=" "/>
		<String name="text" value="ubuntu"/>
		<String name="crlf" value="&#13;&#10;"/>
	</DataModel>

	<!-- <PORT> ::= "PORT" <space> <ip_6_tuple> <crlf>
	     <ip_6_tuple> ::= <ip_number_1> "," <ip_number> "," <ip_number> "," <ip_number> "," <port_nr_1> "," <port_nr_2>
	     where ip_number < 256, ip_number_1 > 0, 1023 < port_nr_1 * 256 + port_nr_2 < 65536 -->
	<DataModel name="PORT">
		<String name="verb" value="PORT"/>
		<String name="space" value=" "/>
		<Block name="ip_6_tuple">
			<String name="ip_number_1" value="127"/>
			<String name="comma1" value=","/>
			<String name="ip_number2" value="0"/>
			<String name="comma2" value=","/>
			<String name="ip_number3" value="0"/>
			<String name="comma3" value=","/>
			<String name="ip_number4" value="1"/>
			<String name="comma4" value=","/>
			<String name="port_nr_1" value="195"/>
			<String name="comma5" value=","/>
			<String name="port_nr_2" value="80"/>
		</Block>
		<String name="crlf" value="&#13;&#10;"/>
	</DataModel>

	<!-- <RNFR> ::= "RNFR" <space> <dir_file> <crlf>
	     where str(<RNFR>.<dir_file>) == "dir_1/dir_2/rn_1.txt" or ... == "dir_1/dir_2/rn_2.txt" -->
	<DataModel name="RNFR">
		<String name="verb" value="RNFR"/>
		<String name="space" value=" "/>
		<Choice name="dir_file">
			<String name="rn_1" value="dir_1/dir_2/rn_1.txt"/>
			<String name="rn_2" value="dir_1/dir_2/rn_2.txt"/>
		</Choice>
		<String name="crlf" value="&#13;&#10;"/>
	</DataModel>

	<!-- <RNTO> ::= "RNTO" <space> <dir_file> <crlf>
	     where str(<RNTO>.<dir_file>) == "dir_1/dir_2/rn_1.txt" or ... == "dir_1/dir_2/rn_2.txt" -->
	<DataModel name="RNTO">
		<String name="verb" value="RNTO"/>
		<String name="space" value=" "/>
		<Choice name="dir_file">
			<String name="rn_2" value="dir_1/dir_2/rn_2.txt"/>
			<String name="rn_1" value="dir_1/dir_2/rn_1.txt"/>
		</Choice>
		<String name="crlf" value="&#13;&#10;"/>
	</DataModel>

	<!-- <DELE> ::= "DELE" <space> <file> <crlf>;  where str(<DELE>.<file>) != "exist_append.txt" -->
	<DataModel name="DELE">
		<String name="verb" value="DELE"/>
		<String name="space" value=" "/>
		<Block name="file">
			<String name="filesystem_name" value="deleted"/>
			<Block name="extension" minOccurs="0" maxOccurs="1">
				<String name="dot" value="."/>
				<String name="filesystem_name" value="txt"/>
			</Block>
		</Block>
		<String name="crlf" value="&#13;&#10;"/>
	</DataModel>

	<!-- <CDUP> ::= "CDUP" <crlf> -->
	<DataModel name="CDUP">
		<String name="verb" value="CDUP"/>
		<String name="crlf" value="&#13;&#10;"/>
	</DataModel>

	<!-- <CWD> ::= "CWD" <space> <directory> <crlf>
	     <directory> ::= "/" | "/"? <filesystem_name> ("/" <filesystem_name>)* "/"? -->
	<DataModel name="CWD">
		<String name="verb" value="CWD"/>
		<String name="space" value=" "/>
		<Choice name="directory">
			<Block name="path">
				<String name="leading_slash" value="/" minOccurs="0" maxOccurs="1"/>
				<String name="filesystem_name" value="dir_1"/>
				<Block name="subdirectory" minOccurs="0" maxOccurs="-1">
					<String name="slash" value="/"/>
					<String name="filesystem_name" value="dir_2"/>
				</Block>
				<String name="trailing_slash" value="/" minOccurs="0" maxOccurs="1"/>
			</Block>
			<String name="root" value="/"/>
		</Choice>
		<String name="crlf" value="&#13;&#10;"/>
	</DataModel>

	<!-- <PWD> ::= "PWD" <crlf> -->
	<DataModel name="PWD">
		<String name="verb" value="PWD"/>
		<String name="crlf" value="&#13;&#10;"/>
	</DataModel>

	<!-- <MKD> ::= "MKD" <space> <filesystem_name> <crlf> -->
	<DataModel name="MKD">
		<String name="verb" value="MKD"/>
		<String name="space" value=" "/>
		<String name="filesystem_name" value="dir_3"/>
		<String name="crlf" value="&#13;&#10;"/>
	</DataModel>

	<!-- <RMD> ::= "RMD" <space> <filesystem_name> <crlf> -->
	<DataModel name="RMD">
		<String name="verb" value="RMD"/>
		<String name="space" value=" "/>
		<String name="filesystem_name" value="dir_3"/>
		<String name="crlf" value="&#13;&#10;"/>
