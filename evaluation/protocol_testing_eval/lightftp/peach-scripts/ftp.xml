	<DataModel name="SITE">
		<String name="verb" value="SITE"/>
		<String name="space" value=" "/>
		<String name="text" value="HELP"/>
		<String name="crlf" value="&#13;&#10;"/>
	</DataModel>

	<!-- <TYPE> ::= "TYPE" <space> ("A" (<space> "N")? | "I") <crlf> -->
	<DataModel name="TYPE">
		<String name="verb" value="TYPE"/>
		<String name="space" value=" "/>
		<Choice name="type">
			<Block name="ascii">
				<String name="A" value="A"/>
				<Block name="non_print" minOccurs="0" maxOccurs="1">
					<String name="space" value=" "/>
					<String name="N" value="N"/>
				</Block>
			</Block>
			<String name="I" value="I"/>
		</Choice>
		<String name="crlf" value="&#13;&#10;"/>
