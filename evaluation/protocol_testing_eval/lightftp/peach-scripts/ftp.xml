	<!-- <PASV_response> ::= '227 Entering Passive Mode (' <pasv_socket> ').' <crlf>
	     <socket_addr> ::= <pasv_ip_1> "," <pasv_ip_2> "," <pasv_ip_3> "," <pasv_ip_4> "," <pasv_port_hi> "," <pasv_port_lo> -->
	<DataModel name="PASV_response">
		<String name="prefix" value="227 Entering Passive Mode (" token="true"/>
		<Block name="pasv_socket">
			<String name="pasv_ip_1"/>
			<String name="comma1" value="," token="true"/>
			<String name="pasv_ip_2"/>
			<String name="comma2" value="," token="true"/>
			<String name="pasv_ip_3"/>
			<String name="comma3" value="," token="true"/>
			<String name="pasv_ip_4"/>
			<String name="comma4" value="," token="true"/>
			<String name="pasv_port_hi"/>
			<String name="comma5" value="," token="true"/>
			<String name="pasv_port_lo"/>
		</Block>
		<String name="suffix" value=")." token="true"/>
		<String name="crlf" value="&#13;&#10;" token="true"/>
	</DataModel>

	<!-- <EPSV_response> ::= '229 Entering Extended Passive Mode (|||' <open_port> '|)\r\n' -->
	<DataModel name="EPSV_response">
		<String name="prefix" value="229 Entering Extended Passive Mode (|||" token="true"/>
		<String name="open_port"/>
		<String name="suffix" value="|)&#13;&#10;" token="true"/>
	</DataModel>

	<!-- <LIST_data> / <RETR_data> / <MLSD_data> ::= r"[\s\S]*" -->
	<DataModel name="LIST_data">
		<Blob name="data"/>
	</DataModel>
	<DataModel name="RETR_data">
		<Blob name="data"/>
	</DataModel>
	<DataModel name="MLSD_data">
		<Blob name="data"/>
	</DataModel>

	<StateModel name="start" initialState="banner_exchange">

		<!-- <start> ::= <banner_exchange> <unauthenticated_state>
		     <banner_exchange> ::= <ServerControl:greeting_block> -->
		<State name="banner_exchange">
			<Action type="input" publisher="Control"><DataModel ref="greeting_block"/></Action>
			<Action type="changeState" ref="unauthenticated_state"/>
		</State>

		<!-- <unauthenticated_exchanges> ::= <AUTH_exchange> <authenticated_state>
		                                  | <AUTH_TLS_upgrade> <unauthenticated_tls_state> -->
		<State name="unauthenticated_state">
			<Action type="changeState" ref="AUTH_exchange" when="random.randrange(2) == 0"/>
			<Action type="changeState" ref="AUTH_TLS_upgrade"/>
		</State>

		<!-- <AUTH_TLS_upgrade> ::= <ClientControl:AUTH_TLS> <ServerControl:AUTH_TLS_response> <SocketControlClient:AUTH_TLS_negotiate>
		     <unauthenticated_tls_state> ::= <AUTH_exchange> <authenticated_state>
		     (AUTH_TLS_negotiate is done by ftp_proxy.py once it relays the 234.) -->
		<State name="AUTH_TLS_upgrade">
			<Action type="output" publisher="Control"><DataModel ref="AUTH_TLS"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="AUTH_TLS_response"/></Action>
			<Action type="changeState" ref="AUTH_exchange"/>
		</State>

		<!-- <AUTH_exchange> ::= <ClientControl:USER> <ServerControl:USER_response> <ClientControl:PASS> <ServerControl:PASS_response> -->
		<State name="AUTH_exchange">
			<Action type="output" publisher="Control"><DataModel ref="USER"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="USER_response"/></Action>
			<Action type="output" publisher="Control"><DataModel ref="PASS"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="PASS_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <authenticated_state> ::= (<control_exchanges> <authenticated_state>)
		                             | ((<PASV_exchange> | <EPSV_exchange>) <data_exchanges> <authenticated_state>)
		                             | <QUIT_exchange> -->
		<State name="authenticated_state">
			<Action type="changeState" ref="control_exchanges" when="random.randrange(3) == 0"/>
			<Action type="changeState" ref="passive_exchanges" when="random.randrange(2) == 0"/>
			<Action type="changeState" ref="QUIT_exchange"/>
		</State>

		<!-- <control_exchanges> ::= (<PROT_exchange> | <PBSZ_exchange> | <OPTS_exchange> | <FEAT_exchange>
		                         | <SIZE_exchange> | <REST_exchange> | <TYPE_exchange> | <SITE_exchange>
		                         | <NOOP_exchange> | <SYST_exchange> | <PORT_exchange> | <HELP_exchange>
		                         | (<RNFR_exchange> <RNTO_exchange>?) | <RMD_exchange> | <MKD_exchange>
		                         | <PWD_exchange> | <CWD_exchange> | <CDUP_exchange> | <DELE_exchange>) -->
		<State name="control_exchanges">
			<Action type="changeState" ref="PROT_exchange" when="random.randrange(19) == 0"/>
			<Action type="changeState" ref="PBSZ_exchange" when="random.randrange(18) == 0"/>
			<Action type="changeState" ref="OPTS_exchange" when="random.randrange(17) == 0"/>
			<Action type="changeState" ref="FEAT_exchange" when="random.randrange(16) == 0"/>
			<Action type="changeState" ref="SIZE_exchange" when="random.randrange(15) == 0"/>
			<Action type="changeState" ref="REST_exchange" when="random.randrange(14) == 0"/>
			<Action type="changeState" ref="TYPE_exchange" when="random.randrange(13) == 0"/>
			<Action type="changeState" ref="SITE_exchange" when="random.randrange(12) == 0"/>
			<Action type="changeState" ref="NOOP_exchange" when="random.randrange(11) == 0"/>
			<Action type="changeState" ref="SYST_exchange" when="random.randrange(10) == 0"/>
			<Action type="changeState" ref="PORT_exchange" when="random.randrange(9) == 0"/>
			<Action type="changeState" ref="HELP_exchange" when="random.randrange(8) == 0"/>
			<Action type="changeState" ref="RNFR_exchange" when="random.randrange(7) == 0"/>
			<Action type="changeState" ref="RMD_exchange" when="random.randrange(6) == 0"/>
			<Action type="changeState" ref="MKD_exchange" when="random.randrange(5) == 0"/>
			<Action type="changeState" ref="PWD_exchange" when="random.randrange(4) == 0"/>
			<Action type="changeState" ref="CWD_exchange" when="random.randrange(3) == 0"/>
			<Action type="changeState" ref="CDUP_exchange" when="random.randrange(2) == 0"/>
			<Action type="changeState" ref="DELE_exchange"/>
		</State>

		<!-- <PROT_exchange> ::= <ClientControl:PROT> <ServerControl:PROT_response> -->
		<State name="PROT_exchange">
			<Action type="output" publisher="Control"><DataModel ref="PROT"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="PROT_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <PBSZ_exchange> ::= <ClientControl:PBSZ> <ServerControl:PBSZ_response> -->
		<State name="PBSZ_exchange">
			<Action type="output" publisher="Control"><DataModel ref="PBSZ"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="PBSZ_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <OPTS_exchange> ::= <ClientControl:OPTS> <ServerControl:OPTS_response> -->
		<State name="OPTS_exchange">
			<Action type="output" publisher="Control"><DataModel ref="OPTS"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="OPTS_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <FEAT_exchange> ::= <ClientControl:FEAT> <ServerControl:FEAT_response> -->
		<State name="FEAT_exchange">
			<Action type="output" publisher="Control"><DataModel ref="FEAT"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="FEAT_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <SIZE_exchange> ::= <ClientControl:SIZE> <ServerControl:SIZE_response> -->
		<State name="SIZE_exchange">
			<Action type="output" publisher="Control"><DataModel ref="SIZE"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="SIZE_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <REST_exchange> ::= <ClientControl:REST> <ServerControl:REST_response> -->
		<State name="REST_exchange">
			<Action type="output" publisher="Control"><DataModel ref="REST"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="REST_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <TYPE_exchange> ::= <ClientControl:TYPE> <ServerControl:TYPE_response> -->
		<State name="TYPE_exchange">
			<Action type="output" publisher="Control"><DataModel ref="TYPE"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="TYPE_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <SITE_exchange> ::= <ClientControl:SITE> <ServerControl:SITE_response> -->
		<State name="SITE_exchange">
			<Action type="output" publisher="Control"><DataModel ref="SITE"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="SITE_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <NOOP_exchange> ::= <ClientControl:NOOP> <ServerControl:NOOP_response> -->
		<State name="NOOP_exchange">
			<Action type="output" publisher="Control"><DataModel ref="NOOP"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="NOOP_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <SYST_exchange> ::= <ClientControl:SYST> <ServerControl:SYST_response> -->
		<State name="SYST_exchange">
			<Action type="output" publisher="Control"><DataModel ref="SYST"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="SYST_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <PORT_exchange> ::= <ClientControl:PORT> <ServerControl:PORT_response> -->
		<State name="PORT_exchange">
			<Action type="output" publisher="Control"><DataModel ref="PORT"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="PORT_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <HELP_exchange> ::= <ClientControl:HELP> <ServerControl:HELP_response> -->
		<State name="HELP_exchange">
			<Action type="output" publisher="Control"><DataModel ref="HELP"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="HELP_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- (<RNFR_exchange> <RNTO_exchange>?)
		     <RNFR_exchange> ::= <ClientControl:RNFR> <ServerControl:RNFR_response> -->
		<State name="RNFR_exchange">
			<Action type="output" publisher="Control"><DataModel ref="RNFR"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="RNFR_response"/></Action>
			<Action type="changeState" ref="RNTO_exchange" when="random.randrange(2) == 0"/>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <RNTO_exchange> ::= <ClientControl:RNTO> <ServerControl:RNTO_response> -->
		<State name="RNTO_exchange">
			<Action type="output" publisher="Control"><DataModel ref="RNTO"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="RNTO_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <RMD_exchange> ::= <ClientControl:RMD> <ServerControl:RMD_response> -->
		<State name="RMD_exchange">
			<Action type="output" publisher="Control"><DataModel ref="RMD"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="RMD_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <MKD_exchange> ::= <ClientControl:MKD> <ServerControl:MKD_response> -->
		<State name="MKD_exchange">
			<Action type="output" publisher="Control"><DataModel ref="MKD"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="MKD_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <PWD_exchange> ::= <ClientControl:PWD> <ServerControl:PWD_response> -->
		<State name="PWD_exchange">
			<Action type="output" publisher="Control"><DataModel ref="PWD"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="PWD_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <CWD_exchange> ::= <ClientControl:CWD> <ServerControl:CWD_response> -->
		<State name="CWD_exchange">
			<Action type="output" publisher="Control"><DataModel ref="CWD"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="CWD_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <CDUP_exchange> ::= <ClientControl:CDUP> <ServerControl:CDUP_response> -->
		<State name="CDUP_exchange">
			<Action type="output" publisher="Control"><DataModel ref="CDUP"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="CDUP_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <DELE_exchange> ::= <ClientControl:DELE> <ServerControl:DELE_response> -->
		<State name="DELE_exchange">
			<Action type="output" publisher="Control"><DataModel ref="DELE"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="DELE_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- (<PASV_exchange> | <EPSV_exchange>) <data_exchanges> <authenticated_state> -->
		<State name="passive_exchanges">
			<Action type="changeState" ref="PASV_exchange" when="random.randrange(2) == 0"/>
			<Action type="changeState" ref="EPSV_exchange"/>
		</State>

		<!-- <PASV_exchange> ::= <ClientControl:PASV> <ServerControl:PASV_response>
		     The data connection is opened once the reply names the port (set_pasv_socket). -->
		<State name="PASV_exchange">
			<Action type="output" publisher="Control"><DataModel ref="PASV"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="PASV_response"/></Action>
			<Action type="open" publisher="Data"/>
			<Action type="changeState" ref="data_exchanges"/>
		</State>

		<!-- <EPSV_exchange> ::= <ClientControl:EPSV> <ServerControl:EPSV_response>
		     The data connection is opened once the reply names the port (open_data_port). -->
		<State name="EPSV_exchange">
			<Action type="output" publisher="Control"><DataModel ref="EPSV"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="EPSV_response"/></Action>
			<Action type="open" publisher="Data"/>
			<Action type="changeState" ref="data_exchanges"/>
		</State>

		<!-- <data_exchanges> ::= <STOR_exchange> | <LIST_exchange> | <ABOR_exchange>
		                        | <APPE_exchange> | <RETR_exchange> | <MLSD_exchange> -->
		<State name="data_exchanges">
			<Action type="changeState" ref="STOR_exchange" when="random.randrange(6) == 0"/>
			<Action type="changeState" ref="LIST_exchange" when="random.randrange(5) == 0"/>
			<Action type="changeState" ref="ABOR_exchange" when="random.randrange(4) == 0"/>
			<Action type="changeState" ref="APPE_exchange" when="random.randrange(3) == 0"/>
			<Action type="changeState" ref="RETR_exchange" when="random.randrange(2) == 0"/>
			<Action type="changeState" ref="MLSD_exchange"/>
		</State>

		<!-- <STOR_exchange> ::= <ClientControl:STOR> <ServerControl:Response_150> <ClientData:STOR_data>*
		                         (<close_data_either> <ServerControl:Response_226>
		                          | <ServerControl:Response_226> <ClientData:STOR_data>* <close_data_either>) -->
		<State name="STOR_exchange">
			<Action type="output" publisher="Control"><DataModel ref="STOR"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="Response_150"/></Action>
			<Action type="changeState" ref="STOR_data"/>
		</State>
		<!-- <ClientData:STOR_data>* -->
		<State name="STOR_data">
			<Action type="changeState" ref="STOR_data_item" when="random.randrange(2) == 0"/>
			<Action type="changeState" ref="STOR_close_then_226" when="random.randrange(2) == 0 or context.controlRecordingIteration"/>
			<Action type="changeState" ref="STOR_226_then_close"/>
		</State>
		<State name="STOR_data_item">
			<Action type="output" publisher="Data"><DataModel ref="STOR_data"/></Action>
			<Action type="changeState" ref="STOR_data"/>
		</State>
		<!-- <close_data_either> <ServerControl:Response_226> -->
		<State name="STOR_close_then_226">
			<Action type="close" publisher="Data"/>
			<Action type="input" publisher="Control"><DataModel ref="Response_226"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>
		<!-- <ServerControl:Response_226> <ClientData:STOR_data>* <close_data_either> -->
		<State name="STOR_226_then_close">
			<Action type="input" publisher="Control"><DataModel ref="Response_226"/></Action>
			<Action type="changeState" ref="STOR_data_after_226"/>
		</State>
		<State name="STOR_data_after_226">
			<Action type="changeState" ref="STOR_data_after_226_item" when="random.randrange(2) == 0"/>
			<Action type="close" publisher="Data"/>
			<Action type="changeState" ref="authenticated_state"/>
		</State>
		<State name="STOR_data_after_226_item">
			<Action type="output" publisher="Data"><DataModel ref="STOR_data"/></Action>
			<Action type="changeState" ref="STOR_data_after_226"/>
		</State>

		<!-- <APPE_exchange> ::= <ClientControl:APPE> <ServerControl:Response_150> <ClientData:APPE_data>*
		                         (<close_data_either> <ServerControl:Response_226>
		                          | <ServerControl:Response_226> <ClientData:APPE_data>* <close_data_either>) -->
		<State name="APPE_exchange">
			<Action type="output" publisher="Control"><DataModel ref="APPE"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="Response_150"/></Action>
			<Action type="changeState" ref="APPE_data"/>
		</State>
		<!-- <ClientData:APPE_data>* -->
		<State name="APPE_data">
			<Action type="changeState" ref="APPE_data_item" when="random.randrange(2) == 0"/>
			<Action type="changeState" ref="APPE_close_then_226" when="random.randrange(2) == 0 or context.controlRecordingIteration"/>
			<Action type="changeState" ref="APPE_226_then_close"/>
		</State>
		<State name="APPE_data_item">
			<Action type="output" publisher="Data"><DataModel ref="APPE_data"/></Action>
			<Action type="changeState" ref="APPE_data"/>
		</State>
		<!-- <close_data_either> <ServerControl:Response_226> -->
		<State name="APPE_close_then_226">
			<Action type="close" publisher="Data"/>
			<Action type="input" publisher="Control"><DataModel ref="Response_226"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>
		<!-- <ServerControl:Response_226> <ClientData:APPE_data>* <close_data_either> -->
		<State name="APPE_226_then_close">
			<Action type="input" publisher="Control"><DataModel ref="Response_226"/></Action>
			<Action type="changeState" ref="APPE_data_after_226"/>
		</State>
		<State name="APPE_data_after_226">
			<Action type="changeState" ref="APPE_data_after_226_item" when="random.randrange(2) == 0"/>
			<Action type="close" publisher="Data"/>
			<Action type="changeState" ref="authenticated_state"/>
		</State>
		<State name="APPE_data_after_226_item">
			<Action type="output" publisher="Data"><DataModel ref="APPE_data"/></Action>
			<Action type="changeState" ref="APPE_data_after_226"/>
		</State>

		<!-- <LIST_exchange> ::= <ClientControl:LIST> <ServerControl:Response_150> <ServerData:LIST_data>?
		                         (<SocketControlServer:close_data> <ServerControl:Response_226>
		                          | <ServerControl:Response_226> <ServerData:LIST_data>? <SocketControlServer:close_data>)
		     The server decides the interleaving; the data and control channels are read separately. -->
		<State name="LIST_exchange">
			<Action type="output" publisher="Control"><DataModel ref="LIST"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="Response_150"/></Action>
			<Action type="input" publisher="Data"><DataModel ref="LIST_data"/></Action>
			<Action type="close" publisher="Data"/>
			<Action type="input" publisher="Control"><DataModel ref="Response_226"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <RETR_exchange> ::= <ClientControl:RETR> <ServerControl:Response_150> <ServerData:RETR_data>?
		                         (<SocketControlServer:close_data> <ServerControl:Response_226>
		                          | <ServerControl:Response_226> <ServerData:RETR_data>? <SocketControlServer:close_data>) -->
		<State name="RETR_exchange">
			<Action type="output" publisher="Control"><DataModel ref="RETR"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="Response_150"/></Action>
			<Action type="input" publisher="Data"><DataModel ref="RETR_data"/></Action>
			<Action type="close" publisher="Data"/>
			<Action type="input" publisher="Control"><DataModel ref="Response_226"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <MLSD_exchange> ::= <ClientControl:MLSD> <ServerControl:Response_150> <ServerData:MLSD_data>?
		                         (<SocketControlServer:close_data> <ServerControl:Response_226>
		                          | <ServerControl:Response_226> <ServerData:MLSD_data>? <SocketControlServer:close_data>) -->
		<State name="MLSD_exchange">
			<Action type="output" publisher="Control"><DataModel ref="MLSD"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="Response_150"/></Action>
			<Action type="input" publisher="Data"><DataModel ref="MLSD_data"/></Action>
			<Action type="close" publisher="Data"/>
			<Action type="input" publisher="Control"><DataModel ref="Response_226"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <ABOR_exchange> ::= <ClientControl:ABOR> (<ServerControl:ABOR_response> <close_data_either>
		                                             | <close_data_either> <ServerControl:ABOR_response>) -->
		<State name="ABOR_exchange">
			<Action type="output" publisher="Control"><DataModel ref="ABOR"/></Action>
			<Action type="changeState" ref="ABOR_response_then_close" when="random.randrange(2) == 0"/>
			<Action type="changeState" ref="ABOR_close_then_response"/>
		</State>
		<State name="ABOR_response_then_close">
			<Action type="input" publisher="Control"><DataModel ref="ABOR_response"/></Action>
			<Action type="close" publisher="Data"/>
			<Action type="changeState" ref="authenticated_state"/>
		</State>
		<State name="ABOR_close_then_response">
			<Action type="close" publisher="Data"/>
			<Action type="input" publisher="Control"><DataModel ref="ABOR_response"/></Action>
			<Action type="changeState" ref="authenticated_state"/>
		</State>

		<!-- <QUIT_exchange> ::= <ClientControl:QUIT> <ServerControl:QUIT_response> -->
		<State name="QUIT_exchange">
			<Action type="output" publisher="Control"><DataModel ref="QUIT"/></Action>
			<Action type="input" publisher="Control"><DataModel ref="QUIT_response"/></Action>
		</State>
	</StateModel>

	<Test name="Default" nonDeterministicActions="true">
		<StateModel ref="start"/>
		<Publisher class="Tcp" name="Control">
			<Param name="Host" value="127.0.0.1"/>
			<Param name="Port" value="2121"/>
			<Param name="Timeout" value="2000"/>
			<Param name="ReadAvailableTimeout" value="100"/>
			<Param name="FaultOnConnectionFailure" value="false"/>
		</Publisher>
		<Publisher class="Tcp" name="Data">
			<Param name="Host" value="127.0.0.1"/>
			<Param name="Port" value="50100"/>
			<Param name="Timeout" value="2000"/>
			<Param name="ReadAvailableTimeout" value="100"/>
			<Param name="FaultOnConnectionFailure" value="false"/>
		</Publisher>
		<Strategy class="Random"/>
	</Test>
</Peach>
