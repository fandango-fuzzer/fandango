FROM ubuntu:22.04

# Install common dependencies
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get -y update && \
    apt-get -y install sudo \
    apt-utils \
    build-essential \
    openssl \
    clang \
    graphviz-dev \
    git \
    autoconf \
    libgnutls28-dev \
    libssl-dev \
    llvm-11 llvm-11-dev clang-11 \
    python3.11 python3-pip \
    nano \
    net-tools \
    vim \
    gdb \
    netcat \
    strace \
    wget

RUN apt-get -y install python3.11 python3.11-dev

RUN apt-get -y install ninja-build

# Exim build dependencies
RUN apt-get -y install psmisc \
    libpcre3-dev \
    pkg-config \
    libdb-dev \
    libgdbm-dev

# Add a new user ubuntu, pass: ubuntu
RUN groupadd ubuntu && \
    useradd -rm -d /home/ubuntu -s /bin/bash -g ubuntu -G sudo -u 1000 ubuntu -p "$(openssl passwd -1 ubuntu)"

RUN chmod 777 /tmp

RUN python3 -m pip install --upgrade pip==20.3.4 && \
    pip3 install --trusted-host pypi.org --trusted-host files.pythonhosted.org gcovr==4.2

RUN python3.11 -m pip install -U pip setuptools wheel

# Install Fandango from the LOCAL checkout copied into the build context by
# sync-fandango.sh (run it before building). Installed editable (-e) and the C++
# parser is recompiled here for the container; mount Python subtrees at runtime
# for live edits without rebuilding. See README Step-7.
COPY .fandango-local /fandango
RUN cd /fandango && python3.11 -m pip install --no-cache-dir -e ".[test]"

# Use ubuntu as default username
USER ubuntu
WORKDIR /home/ubuntu

# Import environment variable to pass as parameter to make (e.g., to make parallel builds with -j)
ARG MAKE_OPT

ENV CC=clang-11
ENV CXX=clang++-11
ENV LLVM_CONFIG=llvm-config-11

# Set up fuzzers
# AFL_NO_X86=1 skips AFL's x86-only assembly self-test so the image also builds
# on arm64. The instrumentation actually used here is afl-clang-fast (llvm_mode),
# which is architecture-independent.
RUN git clone https://github.com/profuzzbench/aflnet.git && \
    cd aflnet && \
    AFL_NO_X86=1 make clean all $MAKE_OPT && \
    cd llvm_mode && make $MAKE_OPT

RUN git clone https://github.com/profuzzbench/aflnwe.git && \
    cd aflnwe && \
    AFL_NO_X86=1 make clean all $MAKE_OPT && \
    cd llvm_mode && make $MAKE_OPT

# Set up environment variables for AFLNet
ENV WORKDIR="/home/ubuntu/experiments"
ENV AFLNET="/home/ubuntu/aflnet"
ENV PATH="${PATH}:${AFLNET}:/home/ubuntu/.local/bin:${WORKDIR}"
ENV AFL_PATH="${AFLNET}"
ENV AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES=1 \
    AFL_SKIP_CPUFREQ=1 \
    AFL_NO_AFFINITY=1

RUN mkdir $WORKDIR

USER root

COPY --chown=ubuntu:ubuntu exim.patch ${WORKDIR}/exim.patch
COPY --chown=ubuntu:ubuntu exim-rand.patch ${WORKDIR}/exim-rand.patch
COPY --chown=ubuntu:ubuntu exim-log-bug.patch ${WORKDIR}/exim-log-bug.patch
COPY --chown=ubuntu:ubuntu exim.configure.patch ${WORKDIR}/exim.configure.patch
COPY exim-fandango-auth.conf /tmp/exim-fandango-auth.conf

# Set up environment variables for ASAN
ENV ASAN_OPTIONS='abort_on_error=1:symbolize=0:detect_leaks=0:detect_stack_use_after_return=1:detect_container_overflow=0:poison_array_cookie=0:malloc_fill_byte=0:max_malloc_fill_size=16777216'

# Download, compile and install Exim for fuzzing (also sets up /usr/exim)
RUN cd ${WORKDIR} && \
    git clone https://github.com/Exim/exim && \
    cd exim && \
    git checkout 38903fb && \
    patch -p1 < ${WORKDIR}/exim-rand.patch && \
    patch -p1 < ${WORKDIR}/exim-log-bug.patch && \
    cd src; mkdir Local; cp src/EDITME Local/Makefile && \
    cd Local; patch -p1 < ${WORKDIR}/exim.patch; cd .. && \
    echo 'AUTH_PLAINTEXT=yes' >> Local/Makefile && \
    AFL_USE_ASAN=1 make CC=afl-clang-fast clean all install $MAKE_OPT

# Download and compile Exim for AFLNet coverage analysis
RUN cd ${WORKDIR} && \
    git clone https://github.com/Exim/exim exim-gcov && \
    cd exim-gcov && \
    git checkout 38903fb && \
    patch -p1 < ${WORKDIR}/exim-rand.patch && \
    patch -p1 < ${WORKDIR}/exim-log-bug.patch && \
    cd src; mkdir Local; cp src/EDITME Local/Makefile && \
    cd Local; patch -p1 < ${WORKDIR}/exim.patch; cd .. && \
    echo 'AUTH_PLAINTEXT=yes' >> Local/Makefile && \
    make CFLAGS="-fprofile-arcs -ftest-coverage" LDFLAGS="-fprofile-arcs -ftest-coverage" LFLAGS+="-lgcov --coverage" clean all $MAKE_OPT

# Download and compile Exim for Fandango coverage analysis
RUN cd ${WORKDIR} && \
    git clone https://github.com/Exim/exim exim-fandango && \
    cd exim-fandango && \
    git checkout 38903fb && \
    patch -p1 < ${WORKDIR}/exim-rand.patch && \
    patch -p1 < ${WORKDIR}/exim-log-bug.patch && \
    cd src; mkdir Local; cp src/EDITME Local/Makefile && \
    cd Local; patch -p1 < ${WORKDIR}/exim.patch; cd .. && \
    echo 'AUTH_PLAINTEXT=yes' >> Local/Makefile && \
    make CFLAGS="-fprofile-arcs -ftest-coverage" LDFLAGS="-fprofile-arcs -ftest-coverage" LFLAGS+="-lgcov --coverage" clean all $MAKE_OPT

# Download and compile Exim with clang source-based coverage (LLVM) for the
# differential-coverage comparison. The profile output path is baked into the
# binary (%p = pid) so it works even though Exim strips most of its environment;
# children write a .profraw to /coverage on exit.
RUN mkdir -p /coverage && chmod 0777 /coverage
RUN cd ${WORKDIR} && \
    git clone https://github.com/Exim/exim exim-covcc && \
    cd exim-covcc && \
    git checkout 38903fb && \
    patch -p1 < ${WORKDIR}/exim-rand.patch && \
    patch -p1 < ${WORKDIR}/exim-log-bug.patch && \
    cd src; mkdir Local; cp src/EDITME Local/Makefile && \
    cd Local; patch -p1 < ${WORKDIR}/exim.patch; cd .. && \
    echo 'AUTH_PLAINTEXT=yes' >> Local/Makefile && \
    make CC=clang-11 \
      CFLAGS="-fprofile-instr-generate=/coverage/exim-%p.profraw -fcoverage-mapping -g -O0" \
      LFLAGS+="-fprofile-instr-generate=/coverage/exim-%p.profraw -fcoverage-mapping" \
      clean all $MAKE_OPT

# Install the differential-coverage analysis tool.
RUN python3.11 -m pip install --no-cache-dir "git+https://github.com/riesentoaster/differential-coverage.git"

# Configure exim and enable a plaintext LOGIN authenticator for Fandango.
# Sender verification is disabled because exim.configure.patch removes the
# dnslookup router, so non-local senders (e.g. a@b.de from the grammar) would
# otherwise fail "verify = sender" and the MAIL/RCPT/DATA flow could not complete.
#
# A catch-all router (fandango_catchall -> local_delivery) is added so EVERY
# message is delivered locally and leaves the spool. Without it, mail to the
# grammar's non-local recipients is unrouteable and freezes in the spool; the
# deterministic message-ids from exim-rand.patch then collide ("Failed to create
# spool file ...-D: File exists"), which Exim reports as a panic and answers with
# a burst of "421 Unexpected failure" -- a benchmark-patch artefact, not real
# SMTP behaviour. Delivering messages keeps the spool clean and avoids it.
RUN cd /usr/exim && \
    patch -p1 < ${WORKDIR}/exim.configure.patch && \
    awk '/^begin authenticators/{print; while((getline line < "/tmp/exim-fandango-auth.conf")>0) print line; close("/tmp/exim-fandango-auth.conf"); next}1' configure > configure.new && \
    mv configure.new configure && \
    sed -i '/require verify[[:space:]]*=[[:space:]]*sender/s/^/#/' configure && \
    sed -i '1i dsn_advertise_hosts = *' configure && \
    awk '/^begin routers/{print; print "fandango_catchall:"; print "  driver = accept"; print "  transport = local_delivery"; print "  user = ubuntu"; print ""; next}1' configure > configure.new && \
    mv configure.new configure && \
    chmod 1777 /var/mail

ENV PATH="/usr/exim/bin:${PATH}"

# Exim drops privileges to its runtime user (ubuntu) for SMTP reception, so the
# gcov-instrumented processes write their .gcda files as ubuntu. The build dirs
# are root-owned, so make them writable; otherwise no coverage data is recorded.
RUN chmod -R 0777 ${WORKDIR}/exim-gcov/src/build-Linux-* ${WORKDIR}/exim-fandango/src/build-Linux-*

COPY --chown=ubuntu:ubuntu in-smtp ${WORKDIR}/in-smtp
COPY --chown=ubuntu:ubuntu smtp.dict ${WORKDIR}/smtp.dict
COPY --chown=ubuntu:ubuntu cov_script.sh ${WORKDIR}/cov_script
COPY --chown=ubuntu:ubuntu run.sh ${WORKDIR}/run
COPY --chown=ubuntu:ubuntu clean.sh ${WORKDIR}/clean
COPY --chown=ubuntu:ubuntu fandango-scripts/ ${WORKDIR}/fandango

# Make the coverage output directory writable for bind mounts
RUN mkdir -p ${WORKDIR}/cov_out && \
    chmod -R 0777 ${WORKDIR}/cov_out
